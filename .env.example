# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=123456789,987654321

# Channel username (e.g. @spotyglobalnews) or numeric ID
CHANNEL_ID=@spotyglobalnews

# Public channel URL
CHANNEL_URL=https://t.me/spotyglobalnews

# News publishing interval in minutes
NEWS_INTERVAL_MINUTES=60

# Enable/disable automatic news publishing (true/false)
AUTO_PUBLISH=true

# SQLite database path (use Railway volume mount path in production)
DB_PATH=/app/data/spoty.db
